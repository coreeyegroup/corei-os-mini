corei-os-mini.coreeye.in {
    header Cache-Control "no-store"
    header X-Content-Type-Options "nosniff"

    @identity {
        path /api/workstation
        method GET
    }
    handle @identity {
        reverse_proxy 127.0.0.1:18786
    }
    # Only these operational routes are exposed; backend session checks protect registries.
    @registry path /api/operator/* /api/registry/*
    handle @registry {
        request_body {
            max_size 32KB
        }
        reverse_proxy 127.0.0.1:18786
    }
    @backend path /api /api/* /docs /docs/* /redoc /openapi.json /health
    handle @backend {
        respond "Operational API access is not enabled on this public shell." 403
    }
    handle /corei-os-mini* {
        redir / 302
    }
    handle {
        root * /var/www/corei-os-mini-workstation/current
        try_files {path} /index.html
        file_server
    }
}
