corei-os-mini.coreeye.in {
    header Cache-Control "no-store"
    header X-Content-Type-Options "nosniff"

    @identity {
        path /api/workstation
        method GET
    }
    handle @identity {
        reverse_proxy 127.0.0.1:18786
    }
    # Only these operational routes are exposed; backend operator sessions protect them.
    @server_file path /api/config/mt5/server-file
    handle @server_file {
        request_body {
            max_size 33554432
        }
        reverse_proxy 127.0.0.1:18786
    }
    @account_import path /api/config/accounts/import
    handle @account_import {
        request_body {
            max_size 2200000
        }
        reverse_proxy 127.0.0.1:18786
    }
    @operational path /api/operator/* /api/config/* /api/admin/* /api/oauth/* /api/infra/*
    handle @operational {
        request_body {
            max_size 64KB
        }
        reverse_proxy 127.0.0.1:18786
    }
    @backend path /api /api/* /docs /docs/* /redoc /openapi.json /health
    handle @backend {
        respond "Operational API access is not enabled on this public shell." 403
    }
    handle /corei-os-mini* {
        redir / 302
    }
    handle {
        root * /var/www/corei-os-mini-workstation/current
        try_files {path} /index.html
        file_server
    }
}
